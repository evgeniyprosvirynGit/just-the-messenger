WEB_PORT=8090
VITE_DEMO_MODE=false
# Public browser key, restricted to the app's allowed origins in MapTiler.
VITE_MAPTILER_API_KEY=
# Optional Google OpenID Connect login. Register this exact callback URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8090/api/auth/google/callback
POSTGRES_DB=planet_chat
POSTGRES_USER=planet_chat
POSTGRES_PASSWORD=replace-with-a-long-random-password
