{
  "name": "planet-chat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:starfield && tsc -b && vite build",
    "generate:starfield": "node scripts/generate-starfield-skybox.mjs",
